# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication Secrets
# Generate random 32+ character secrets in production
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Access PINs (Must be hashed in database or set securely here)
OWNER_PIN=your_owner_pin_here
EMPLOYEE_PIN=your_employee_pin_here

# CORS Allowed Origin (e.g. http://localhost:5173 for local dev)
CORS_ORIGIN=http://localhost:5173

# Google Sheets & Google Drive Integration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_WEBHOOK_URL=your_webhook_url_here
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Google Cloud Service Account Credentials
# Point to local JSON path or supply inline JSON string
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_KEY=
